NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
DATABASE_URL=mysql://user:password@localhost:3306/aj_car_rentals
FRONTEND_ORIGINS=http://localhost:5173
CSRF_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=ajvrms_session
SESSION_TTL_SECONDS=14400
SESSION_IDLE_TTL_SECONDS=14400
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
PASSWORD_RESET_TTL_SECONDS=1800
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VEHICLE_STORAGE_ROOT=./var/private-uploads
VEHICLE_IMAGE_MAX_BYTES=10485760
VEHICLE_DOCUMENT_MAX_BYTES=20971520
DOCUMENT_EXPIRY_WARNING_DAYS=30
BUSINESS_NAME=AJ Car Rentals
# Public business WhatsApp number in international format, digits only (for click-to-chat).
WHATSAPP_BUSINESS_NUMBER=
# click_to_chat (default, no API) or cloud_api (Meta WhatsApp Business Cloud API).
WHATSAPP_PROVIDER=click_to_chat
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_CONFIRMATION_TEMPLATE=booking_confirmed
WHATSAPP_DEFAULT_COUNTRY_CODE=94
