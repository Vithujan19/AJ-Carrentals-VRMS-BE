SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VEHICLE_STORAGE_ROOT=./var/private-uploads
VEHICLE_IMAGE_MAX_BYTES=10485760
VEHICLE_DOCUMENT_MAX_BYTES=20971520
DOCUMENT_EXPIRY_WARNING_DAYS=30
