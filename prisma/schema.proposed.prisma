model DamageReport {
  id                   String        @id @default(uuid()) @db.Char(36)
  inspectionId         String        @db.Char(36)
  category             DamageCategory
  severity             DamageSeverity
  origin               DamageOrigin
  status               DamageStatus  @default(OPEN)
  description          String        @db.VarChar(2000)
  location             String?       @db.VarChar(160)
  estimatedRepairCost  Decimal?      @db.Decimal(12, 2)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)
  resolvedAt           DateTime?     @db.DateTime(3)

  inspection  RentalInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images      DamageImage[]
  resolutions DamageResolution[]

  @@index([inspectionId, origin, status])
  @@index([category, severity, status])
}

model DamageImage {
  id             String   @id @default(uuid()) @db.Char(36)
  damageReportId String   @db.Char(36)
