model ReturnAccessory {
  id                  String   @id @default(uuid()) @db.Char(36)
  rentalReturnId      String   @db.Char(36)
  handoverAccessoryId String   @db.Char(36)
  quantityReturned    Int      @default(0) @db.UnsignedSmallInt
