model MaintenanceCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  jobs      MaintenanceJob[]
  schedules MaintenanceSchedule[]
}

model MaintenanceJob {
  id                    String           @id @default(uuid()) @db.Char(36)
  vehicleId             String           @db.Char(36)
  categoryId            String           @db.Char(36)
  maintenanceScheduleId String?          @db.Char(36)
  createdByStaffId      String           @db.Char(36)
  status                MaintenanceStatus @default(PLANNED)
  summary               String           @db.VarChar(255)
  description           String?          @db.Text
  serviceProvider       String?          @db.VarChar(160)
  scheduledStartAt      DateTime?        @db.DateTime(3)
  estimatedCompletionAt DateTime?        @db.DateTime(3)
  actualStartAt         DateTime?        @db.DateTime(3)
  completedAt           DateTime?        @db.DateTime(3)
  odometerKm            Int?             @db.UnsignedInt
  estimatedPartsCost    Decimal?         @db.Decimal(12, 2)
  estimatedLabourCost   Decimal?         @db.Decimal(12, 2)
  nextServiceAt         DateTime?        @db.DateTime(3)
  nextServiceOdometerKm Int?             @db.UnsignedInt
  createdAt             DateTime         @default(now()) @db.DateTime(3)
  updatedAt             DateTime         @updatedAt @db.DateTime(3)
  cancelledAt           DateTime?        @db.DateTime(3)

  vehicle           Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category          MaintenanceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schedule          MaintenanceSchedule?     @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy         StaffUser                @relation("MaintenanceCreator", fields: [createdByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  availabilityBlock VehicleAvailabilityBlock?
  expenses          Expense[]
  documents         MaintenanceDocument[]
  damageResolutions DamageResolution[]

  @@index([vehicleId, status, scheduledStartAt])
  @@index([categoryId, status])
  @@index([status, nextServiceAt])
  @@index([status, nextServiceOdometerKm])
}

model MaintenanceSchedule {
  id                   String                   @id @default(uuid()) @db.Char(36)
  vehicleId            String                   @db.Char(36)
  categoryId           String                   @db.Char(36)
  status               MaintenanceScheduleStatus @default(ACTIVE)
  dueAt                DateTime?                @db.DateTime(3)
  dueAtOdometerKm      Int?                     @db.UnsignedInt
  recurrenceDays       Int?                     @db.UnsignedInt
  recurrenceKilometres Int?                     @db.UnsignedInt
  notes                String?                  @db.VarChar(1000)
  createdAt            DateTime                 @default(now()) @db.DateTime(3)
  updatedAt            DateTime                 @updatedAt @db.DateTime(3)

  vehicle  Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  jobs     MaintenanceJob[]

  @@index([vehicleId, status, dueAt])
  @@index([status, dueAtOdometerKm])
}

model MaintenanceDocument {
