  handover    RentalHandover? @relation(fields: [handoverId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalReturn RentalReturn?  @relation(fields: [rentalReturnId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inspectedBy StaffUser       @relation("InspectionStaff", fields: [inspectedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  photos      InspectionPhoto[]
  damages     DamageReport[]

  @@index([handoverId, stage, inspectedAt])
  @@index([rentalReturnId, stage, inspectedAt])
  @@index([inspectedByStaffId, inspectedAt])
}

model InspectionPhoto {
  id           String   @id @default(uuid()) @db.Char(36)
  inspectionId String   @db.Char(36)
  storageKey   String   @unique @db.VarChar(512)
  caption      String?  @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  sizeBytes    BigInt   @db.UnsignedBigInt
  sha256       String?  @db.Char(64)
  capturedAt   DateTime? @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  inspection RentalInspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([inspectionId, createdAt])
