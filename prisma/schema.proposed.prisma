  sizeBytes      BigInt   @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @db.DateTime(3)

  damageReport DamageReport @relation(fields: [damageReportId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([damageReportId, createdAt])
}

model DamageResolution {
  id                 String                @id @default(uuid()) @db.Char(36)
  damageReportId     String                @db.Char(36)
