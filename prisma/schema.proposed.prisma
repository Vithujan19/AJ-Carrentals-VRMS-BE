generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  OTHER
}

enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  REVENUE_LICENSE
  EMISSION_CERTIFICATE
  OTHER
}

enum RentalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum PricingRuleType {
  FIXED_DISCOUNT
  PERCENT_DISCOUNT
  FIXED_SURCHARGE
  PERCENT_SURCHARGE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  FLAGGED
}

enum CustomerDocumentType {
  NIC_FRONT
  NIC_BACK
  DRIVING_LICENCE_FRONT
  DRIVING_LICENCE_BACK
  OTHER
}

enum CustomerContactType {
  EMERGENCY
  ALTERNATE
  OTHER
}

enum BookingStatus {
  PENDING
  UNDER_REVIEW
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  NO_SHOW
  HANDED_OVER
  RETURNED
  COMPLETED
}

enum BookingSource {
  PUBLIC_WEBSITE
  STAFF_PORTAL
  PHONE
  WHATSAPP
  OTHER
}

enum BookingChargeType {
  RENTAL
  DISCOUNT
  EXTRA_KILOMETRE
  LATE_RETURN
  DAMAGE
  CLEANING
  DELIVERY
  OTHER
}

enum ChargeDirection {
  DEBIT
  CREDIT
}

enum AvailabilityBlockReason {
  MAINTENANCE
  REPAIR
  LATE_RETURN
  OPERATIONAL
  ADMINISTRATIVE
  OTHER
}

enum AvailabilityBlockStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

enum AcknowledgementMethod {
  SIGNATURE
  PIN
  IN_PERSON
  OTHER
}

enum InspectionStage {
  HANDOVER
  RETURN
  ADDITIONAL
}

enum InspectionCondition {
  GOOD
  MINOR_ISSUE
  DAMAGED
  NOT_APPLICABLE
}

enum DamageCategory {
  BODY
  GLASS
  TYRE
  INTERIOR
  MECHANICAL
  ACCESSORY
  OTHER
}

enum DamageSeverity {
  LOW
  MEDIUM
  HIGH
}

enum DamageOrigin {
  PRE_EXISTING
  NEW
}

enum DamageStatus {
  OPEN
  ASSESSED
  RESOLVED
  WAIVED
}

enum DamageResolutionType {
  REPAIRED
  CUSTOMER_CHARGED
  WAIVED
  OTHER
}

enum PaymentDirection {
  COLLECTION
  REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

enum PaymentPurpose {
  ADVANCE
  PARTIAL
  FINAL
  SECURITY_DEPOSIT
  OTHER
}

enum PaymentAllocationType {
  RENTAL
  SECURITY_DEPOSIT
  OTHER
}

enum MaintenanceStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  VOIDED
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_STATUS_CHANGED
  PAYMENT_RECORDED
  PAYMENT_REFUNDED
  HANDOVER_COMPLETED
  RETURN_COMPLETED
  MAINTENANCE_DUE
  EXPENSE_SUBMITTED
  OTHER
}

model StaffUser {
  id                String      @id @default(uuid()) @db.Char(36)
  emailNormalized   String      @unique @db.VarChar(254)
  displayName       String      @db.VarChar(160)
  passwordHash      String      @db.VarChar(255)
  status            StaffStatus @default(ACTIVE)
  passwordChangedAt DateTime?   @db.DateTime(3)
  lastLoginAt       DateTime?   @db.DateTime(3)
  lockedUntil       DateTime?   @db.DateTime(3)
  createdAt         DateTime    @default(now()) @db.DateTime(3)
  updatedAt         DateTime    @updatedAt @db.DateTime(3)
  deactivatedAt     DateTime?   @db.DateTime(3)

  roleAssignments              StaffRole[]
  sessions                     StaffSession[]
  vehicleStatusChanges         VehicleStatusHistory[]      @relation("VehicleStatusActor")
  createdBookings              Booking[]                   @relation("BookingCreator")
  bookingScheduleChanges       BookingScheduleChange[]     @relation("BookingScheduleActor")
  confirmedBookings            Booking[]                   @relation("BookingConfirmer")
  rejectedBookings             Booking[]                   @relation("BookingRejecter")
  cancelledBookings            Booking[]                   @relation("BookingCanceller")
  bookingStatusHistory         BookingStatusHistory[]      @relation("BookingStatusActor")
  createdBookingCharges        BookingCharge[]             @relation("BookingChargeCreator")
  createdAvailabilityBlocks    VehicleAvailabilityBlock[]  @relation("AvailabilityBlockCreator")
  availabilityBlockHistory    AvailabilityBlockHistory[]  @relation("AvailabilityHistoryActor")
  handovers                    RentalHandover[]            @relation("HandoverStaff")
  returns                      RentalReturn[]              @relation("ReturnStaff")
  inspections                  RentalInspection[]          @relation("InspectionStaff")
  damageResolutions            DamageResolution[]          @relation("DamageResolutionActor")
  payments                     Payment[]                   @relation("PaymentRecorder")
  depositApplications          DepositApplication[]         @relation("DepositApplicationActor")
  maintenanceJobs              MaintenanceJob[]            @relation("MaintenanceCreator")
  submittedExpenses            Expense[]                   @relation("ExpenseSubmitter")
  approvedExpenses             Expense[]                   @relation("ExpenseApprover")
  expenseApprovalHistory       ExpenseApprovalHistory[]    @relation("ExpenseHistoryActor")
  auditLogs                    AuditLog[]                  @relation("AuditActor")
  notifications                Notification[]              @relation("NotificationRecipient")
  createdRentalPolicies        RentalPolicy[]              @relation("RentalPolicyCreator")
  updatedBusinessProfiles      BusinessProfile[]           @relation("BusinessProfileUpdater")
  updatedSystemSettings        SystemSetting[]             @relation("SystemSettingUpdater")

  @@index([status, deactivatedAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  staffLinks      StaffRole[]
  permissionLinks RolePermission[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  roleLinks RolePermission[]
}

model StaffRole {
  staffUserId String   @db.Char(36)
  roleId      String   @db.Char(36)
  assignedAt  DateTime @default(now()) @db.DateTime(3)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([staffUserId, roleId])
  @@index([roleId, staffUserId])
}

model RolePermission {
  roleId       String   @db.Char(36)
  permissionId String   @db.Char(36)
  grantedAt    DateTime @default(now()) @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId, roleId])
}

model StaffSession {
  id          String    @id @default(uuid()) @db.Char(36)
  staffUserId String    @db.Char(36)
  tokenHash   String    @unique @db.Char(64)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  lastUsedAt  DateTime? @db.DateTime(3)
  expiresAt   DateTime  @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(512)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([staffUserId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Vehicle {
  id                   String        @id @default(uuid()) @db.Char(36)
  registrationNumber   String        @unique @db.VarChar(24)
  currentOdometerKm    Int?          @db.UnsignedInt
  description          String?       @db.Text
  status               VehicleStatus @default(ACTIVE)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)
  archivedAt           DateTime?     @db.DateTime(3)

  specification   VehicleSpecification?
  images          VehicleImage[]
  documents       VehicleDocument[]
  statusHistory   VehicleStatusHistory[]
  rates           VehicleRate[]
  pricingRules    PricingRule[]
  bookings        Booking[]
  availabilityBlocks VehicleAvailabilityBlock[]
  maintenanceJobs MaintenanceJob[]
  maintenanceSchedules MaintenanceSchedule[]
  expenses        Expense[]

  @@index([status, archivedAt])
  @@index([status, currentOdometerKm])
}

model VehicleSpecification {
  id             String       @id @default(uuid()) @db.Char(36)
  vehicleId      String       @unique @db.Char(36)
  make           String       @db.VarChar(80)
  model          String       @db.VarChar(100)
  variant        String?      @db.VarChar(100)
  manufacturingYear Int?      @db.UnsignedSmallInt
  engineCapacityCc  Int?      @db.UnsignedSmallInt
  fuelType       FuelType
  transmission   Transmission
  colour         String?      @db.VarChar(50)
  seatingCapacity Int?        @db.UnsignedTinyInt
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([make, model, manufacturingYear])
  @@index([fuelType, transmission])
}

model VehicleStatusHistory {
  id                 String        @id @default(uuid()) @db.Char(36)
  vehicleId          String        @db.Char(36)
  changedByStaffId   String?       @db.Char(36)
  fromStatus         VehicleStatus?
  toStatus           VehicleStatus
  reason             String?       @db.VarChar(1000)
  changedAt          DateTime      @default(now()) @db.DateTime(3)

  vehicle Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor   StaffUser? @relation("VehicleStatusActor", fields: [changedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([vehicleId, changedAt])
  @@index([changedByStaffId, changedAt])
}

model VehicleImage {
  id           String    @id @default(uuid()) @db.Char(36)
  vehicleId    String    @db.Char(36)
  storageKey   String    @unique @db.VarChar(512)
  caption      String?   @db.VarChar(255)
  sortOrder    Int       @default(0)
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  archivedAt   DateTime? @db.DateTime(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([vehicleId, isPublished, sortOrder])
}

model VehicleDocument {
  id           String             @id @default(uuid()) @db.Char(36)
  vehicleId    String             @db.Char(36)
  documentType VehicleDocumentType
  storageKey   String             @unique @db.VarChar(512)
  originalName String             @db.VarChar(255)
  mimeType     String             @db.VarChar(100)
  sizeBytes    BigInt             @db.UnsignedBigInt
  expiresAt    DateTime?          @db.Date
  uploadedAt   DateTime           @default(now()) @db.DateTime(3)
  archivedAt   DateTime?          @db.DateTime(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([vehicleId, documentType, expiresAt])
}

model RentalPackage {
  id             String       @id @default(uuid()) @db.Char(36)
  code           String       @unique @db.VarChar(40)
  name           String       @db.VarChar(120)
  rentalPeriod   RentalPeriod
  durationCount  Int          @default(1) @db.UnsignedSmallInt
  conditions     String?      @db.Text
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  vehicleRates VehicleRate[]
  pricingRules PricingRule[]
  bookings     Booking[]

  @@index([isActive, rentalPeriod])
}

model VehicleRate {
  id                    String      @id @default(uuid()) @db.Char(36)
  vehicleId             String      @db.Char(36)
  rentalPackageId       String      @db.Char(36)
  rentalPrice           Decimal     @db.Decimal(12, 2)
  currency              String      @default("LKR") @db.Char(3)
  includedMileageKm     Int         @db.UnsignedInt
  additionalKmRate      Decimal     @db.Decimal(12, 2)
  securityDeposit       Decimal     @db.Decimal(12, 2)
  effectiveFrom         DateTime    @db.DateTime(3)
  effectiveTo           DateTime?   @db.DateTime(3)
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now()) @db.DateTime(3)
  updatedAt             DateTime    @updatedAt @db.DateTime(3)

  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalPackage RentalPackage @relation(fields: [rentalPackageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookings      Booking[]

  @@unique([vehicleId, rentalPackageId, effectiveFrom])
  @@index([vehicleId, rentalPackageId, isActive, effectiveFrom])
  @@index([effectiveTo])
}

model PricingRule {
  id                String          @id @default(uuid()) @db.Char(36)
  code              String          @unique @db.VarChar(60)
  name              String          @db.VarChar(120)
  ruleType          PricingRuleType
  value             Decimal         @db.Decimal(12, 2)
  vehicleId         String?         @db.Char(36)
  rentalPackageId   String?         @db.Char(36)
  effectiveFrom     DateTime        @db.DateTime(3)
  effectiveTo       DateTime?       @db.DateTime(3)
  priority          Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @db.DateTime(3)

  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalPackage RentalPackage? @relation(fields: [rentalPackageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingCharges BookingCharge[]

  @@index([isActive, effectiveFrom, effectiveTo, priority])
  @@index([vehicleId, isActive, effectiveFrom])
  @@index([rentalPackageId, isActive, effectiveFrom])
}

model Customer {
  id                       String         @id @default(uuid()) @db.Char(36)
  fullName                 String         @db.VarChar(160)
  mobileNumber             String         @db.VarChar(32)
  whatsappNumber           String?        @db.VarChar(32)
  email                    String?        @db.VarChar(254)
  addressLine1             String?        @db.VarChar(160)
  addressLine2             String?        @db.VarChar(160)
  city                     String?        @db.VarChar(100)
  nicCiphertext            String?        @db.VarChar(1024)
  nicLookupHash            String?        @unique @db.Char(64)
  drivingLicenceCiphertext String?        @db.VarChar(1024)
  licenceLookupHash        String?        @unique @db.Char(64)
  licenceExpiryDate        DateTime?      @db.Date
  internalNotes            String?        @db.Text
  status                   CustomerStatus @default(ACTIVE)
  createdAt                DateTime       @default(now()) @db.DateTime(3)
  updatedAt                DateTime       @updatedAt @db.DateTime(3)
  archivedAt               DateTime?      @db.DateTime(3)

  contacts  CustomerContact[]
  documents CustomerDocument[]
  bookings  Booking[]

  @@index([mobileNumber])
  @@index([whatsappNumber])
  @@index([email])
  @@index([fullName])
  @@index([status, archivedAt])
}

model CustomerContact {
  id               String             @id @default(uuid()) @db.Char(36)
  customerId       String             @db.Char(36)
  contactType      CustomerContactType
  fullName         String             @db.VarChar(160)
  relationship     String?            @db.VarChar(80)
  phoneNumber      String             @db.VarChar(32)
  isPrimary        Boolean            @default(false)
  createdAt        DateTime           @default(now()) @db.DateTime(3)
  archivedAt       DateTime?          @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId, contactType, archivedAt])
}

model CustomerDocument {
  id                String              @id @default(uuid()) @db.Char(36)
  customerId        String              @db.Char(36)
  documentType      CustomerDocumentType
  storageKey        String              @unique @db.VarChar(512)
  originalName      String              @db.VarChar(255)
  mimeType          String              @db.VarChar(100)
  sizeBytes         BigInt              @db.UnsignedBigInt
  sha256            String?             @db.Char(64)
  expiresAt         DateTime?           @db.Date
  uploadedAt        DateTime            @default(now()) @db.DateTime(3)
  archivedAt        DateTime?           @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId, documentType, archivedAt])
  @@index([expiresAt])
}

model BookingReferenceCounter {
  year         Int      @id @db.UnsignedSmallInt
  lastSequence Int      @default(0) @db.UnsignedInt
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  bookings Booking[]
}

model Booking {
  id                         String        @id @default(uuid()) @db.Char(36)
  referenceYear              Int           @db.UnsignedSmallInt
  referenceSequence          Int           @db.UnsignedInt
  reference                  String        @unique @db.VarChar(20)
  customerId                 String        @db.Char(36)
  vehicleId                  String        @db.Char(36)
  rentalPackageId            String        @db.Char(36)
  vehicleRateId              String?       @db.Char(36)
  rentalPolicyId             String?       @db.Char(36)
  createdByStaffId           String?       @db.Char(36)
  confirmedByStaffId         String?       @db.Char(36)
  rejectedByStaffId          String?       @db.Char(36)
  cancelledByStaffId         String?       @db.Char(36)
  source                     BookingSource @default(PUBLIC_WEBSITE)
  status                     BookingStatus @default(PENDING)
  pickupAt                   DateTime      @db.DateTime(3)
  returnAt                   DateTime      @db.DateTime(3)
  rentalDurationUnits        Decimal       @db.Decimal(8, 2)
  packageNameSnapshot        String        @db.VarChar(120)
  rentalPeriodSnapshot       RentalPeriod
  durationCountSnapshot      Int           @db.UnsignedSmallInt
  packageConditionsSnapshot String?        @db.Text
  rentalPriceSnapshot        Decimal       @db.Decimal(12, 2)
  includedMileageKmSnapshot  Int           @db.UnsignedInt
  additionalKmRateSnapshot   Decimal       @db.Decimal(12, 2)
  securityDepositSnapshot    Decimal       @db.Decimal(12, 2)
  estimatedTotal             Decimal       @db.Decimal(12, 2)
  confirmedTotal             Decimal?      @db.Decimal(12, 2)
  rentalPolicyVersionSnapshot Int?         @db.UnsignedInt
  rentalTermsSnapshot        String?       @db.LongText
  currency                   String        @default("LKR") @db.Char(3)
  customerNameSnapshot       String        @db.VarChar(160)
  customerMobileSnapshot     String        @db.VarChar(32)
  customerEmailSnapshot      String?       @db.VarChar(254)
  registrationSnapshot       String        @db.VarChar(24)
  customerNotes              String?       @db.Text
  internalNotes              String?       @db.Text
  rejectionReason            String?       @db.VarChar(1000)
  rejectedAt                 DateTime?     @db.DateTime(3)
  cancellationReason         String?       @db.VarChar(1000)
  cancelledAt                DateTime?     @db.DateTime(3)
  confirmedAt                DateTime?     @db.DateTime(3)
  createdAt                  DateTime      @default(now()) @db.DateTime(3)
  updatedAt                  DateTime      @updatedAt @db.DateTime(3)

  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle          Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rentalPackage    RentalPackage            @relation(fields: [rentalPackageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicleRate      VehicleRate?             @relation(fields: [vehicleRateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rentalPolicy     RentalPolicy?            @relation(fields: [rentalPolicyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  referenceCounter BookingReferenceCounter  @relation(fields: [referenceYear], references: [year], onDelete: Restrict, onUpdate: Cascade)
  createdBy        StaffUser?               @relation("BookingCreator", fields: [createdByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  confirmedBy      StaffUser?               @relation("BookingConfirmer", fields: [confirmedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedBy       StaffUser?               @relation("BookingRejecter", fields: [rejectedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cancelledBy      StaffUser?               @relation("BookingCanceller", fields: [cancelledByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  statusHistory    BookingStatusHistory[]
  scheduleChanges  BookingScheduleChange[]
  charges          BookingCharge[]
  handover         RentalHandover?
  payments         Payment[]
  depositApplications DepositApplication[]

  @@unique([referenceYear, referenceSequence])
  @@index([vehicleId, status, pickupAt, returnAt])
  @@index([customerId, createdAt])
  @@index([status, pickupAt])
  @@index([createdAt])
}

model BookingScheduleChange {
  id                 String   @id @default(uuid()) @db.Char(36)
  bookingId          String   @db.Char(36)
  changedByStaffId   String?  @db.Char(36)
  previousPickupAt   DateTime @db.DateTime(3)
  previousReturnAt   DateTime @db.DateTime(3)
  newPickupAt        DateTime @db.DateTime(3)
  newReturnAt        DateTime @db.DateTime(3)
  reason             String   @db.VarChar(1000)
  changedAt          DateTime @default(now()) @db.DateTime(3)

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy StaffUser? @relation("BookingScheduleActor", fields: [changedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([bookingId, changedAt])
  @@index([changedByStaffId, changedAt])
}

model BookingStatusHistory {
  id                  String        @id @default(uuid()) @db.Char(36)
  bookingId           String        @db.Char(36)
  changedByStaffId    String?       @db.Char(36)
  fromStatus          BookingStatus?
  toStatus            BookingStatus
  reason              String?       @db.VarChar(1000)
  occurredAt          DateTime      @default(now()) @db.DateTime(3)

  booking Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor   StaffUser? @relation("BookingStatusActor", fields: [changedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([bookingId, occurredAt])
  @@index([changedByStaffId, occurredAt])
}

model BookingCharge {
  id                  String           @id @default(uuid()) @db.Char(36)
  bookingId           String           @db.Char(36)
  createdByStaffId    String?          @db.Char(36)
  pricingRuleId       String?          @db.Char(36)
  chargeType          BookingChargeType
  direction           ChargeDirection
  amount              Decimal          @db.Decimal(12, 2)
  currency            String           @default("LKR") @db.Char(3)
  description         String           @db.VarChar(1000)
  pricingRuleSnapshot String?          @db.VarChar(100)
  isInitialQuoteLine  Boolean          @default(false)
  recognizedAt        DateTime?        @db.DateTime(3)
  createdAt           DateTime         @default(now()) @db.DateTime(3)
  voidedAt            DateTime?        @db.DateTime(3)
  voidReason          String?          @db.VarChar(1000)

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   StaffUser?   @relation("BookingChargeCreator", fields: [createdByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  pricingRule PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  depositApplications DepositApplication[]

  @@index([bookingId, createdAt, voidedAt])
  @@index([pricingRuleId])
  @@index([recognizedAt])
}

model VehicleAvailabilityBlock {
  id                 String                  @id @default(uuid()) @db.Char(36)
  vehicleId          String                  @db.Char(36)
  maintenanceJobId   String?                 @unique @db.Char(36)
  createdByStaffId   String?                 @db.Char(36)
  reason             AvailabilityBlockReason
  status             AvailabilityBlockStatus @default(ACTIVE)
  startsAt           DateTime                @db.DateTime(3)
  endsAt             DateTime?               @db.DateTime(3)
