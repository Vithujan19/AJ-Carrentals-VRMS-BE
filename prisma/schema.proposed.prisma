model RentalInspection {
  id                        String               @id @default(uuid()) @db.Char(36)
  handoverId                String?              @db.Char(36)
  rentalReturnId            String?              @db.Char(36)
  inspectedByStaffId        String               @db.Char(36)
  stage                     InspectionStage
  inspectedAt               DateTime             @default(now()) @db.DateTime(3)
  conditionSummary          String?              @db.Text
  customerAcknowledgedAt    DateTime?            @db.DateTime(3)
