  resolvedBy   StaffUser?      @relation("DamageResolutionActor", fields: [resolvedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([damageReportId, resolvedAt])
  @@index([maintenanceJobId])
}

model Payment {
  id                String           @id @default(uuid()) @db.Char(36)
  bookingId         String           @db.Char(36)
  recordedByStaffId String           @db.Char(36)
  originalPaymentId String?          @db.Char(36)
  direction         PaymentDirection
  purpose           PaymentPurpose
  status            PaymentStatus    @default(PENDING)
  method            PaymentMethod
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @default("LKR") @db.Char(3)
  reference         String?          @db.VarChar(160)
  idempotencyKey    String?          @unique @db.VarChar(100)
  notes             String?          @db.VarChar(1000)
  transactionAt     DateTime         @db.DateTime(3)
  recordedAt        DateTime         @default(now()) @db.DateTime(3)
  settledAt         DateTime?        @db.DateTime(3)
  voidedAt          DateTime?        @db.DateTime(3)

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordedBy    StaffUser @relation("PaymentRecorder", fields: [recordedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  original      Payment? @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refunds       Payment[] @relation("PaymentRefunds")
  allocations   PaymentAllocation[]
  receipts      PaymentReceipt[]

  @@index([bookingId, status, direction, transactionAt])
  @@index([recordedByStaffId, recordedAt])
  @@index([reference])
  @@index([originalPaymentId])
}

model PaymentAllocation {
