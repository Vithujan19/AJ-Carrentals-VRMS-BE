model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  expenses Expense[]
}

model Expense {
  id                    String               @id @default(uuid()) @db.Char(36)
  categoryId            String               @db.Char(36)
  vehicleId             String?              @db.Char(36)
  maintenanceJobId      String?              @db.Char(36)
  submittedByStaffId    String               @db.Char(36)
  approvedByStaffId     String?              @db.Char(36)
  amount                Decimal              @db.Decimal(12, 2)
  currency              String               @default("LKR") @db.Char(3)
  expenseDate           DateTime             @db.DateTime(3)
  description           String               @db.VarChar(1000)
  paymentMethod         ExpensePaymentMethod?
  vendorName            String?              @db.VarChar(160)
  vendorInvoiceReference String?             @db.VarChar(160)
  deduplicationKey      String?              @unique @db.Char(64)
  status                ExpenseStatus        @default(PENDING)
  submittedAt           DateTime             @default(now()) @db.DateTime(3)
  approvedAt            DateTime?            @db.DateTime(3)
  rejectedAt            DateTime?            @db.DateTime(3)
  approvalNote          String?              @db.VarChar(1000)

  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  maintenanceJob MaintenanceJob?  @relation(fields: [maintenanceJobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy    StaffUser       @relation("ExpenseSubmitter", fields: [submittedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy     StaffUser?      @relation("ExpenseApprover", fields: [approvedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  history        ExpenseApprovalHistory[]
  documents      ExpenseDocument[]

  @@index([expenseDate, status])
  @@index([categoryId, expenseDate, status])
  @@index([vehicleId, expenseDate, status])
  @@index([maintenanceJobId, expenseDate])
  @@index([submittedByStaffId, submittedAt])
}

model ExpenseApprovalHistory {
