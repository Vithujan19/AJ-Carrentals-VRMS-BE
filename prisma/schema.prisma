  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordedBy    StaffUser @relation("PaymentRecorder", fields: [recordedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  original      Payment? @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refunds       Payment[] @relation("PaymentRefunds")
  allocations   PaymentAllocation[]
  receipts      PaymentReceipt[]
  corrections       PaymentCorrection[]

  @@index([bookingId, status, direction, transactionAt])
  @@index([recordedByStaffId, recordedAt])
  @@index([reference])
  @@index([originalPaymentId])
}

model PaymentCorrection {
  id              String   @id @default(uuid()) @db.Char(36)
  paymentId       String   @db.Char(36)
  actorStaffId    String   @db.Char(36)
  previousStatus  PaymentStatus
  newStatus       PaymentStatus
  reason          String   @db.VarChar(1000)
  occurredAt      DateTime @default(now()) @db.DateTime(3)

  payment Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor   StaffUser @relation("PaymentCorrectionActor", fields: [actorStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([paymentId, occurredAt])
  @@index([actorStaffId, occurredAt])
}

model PaymentAllocation {
  id             String               @id @default(uuid()) @db.Char(36)
  paymentId      String               @db.Char(36)
  allocationType PaymentAllocationType
  amount         Decimal              @db.Decimal(12, 2)
  createdAt      DateTime             @default(now()) @db.DateTime(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paymentId, allocationType])
  @@index([allocationType, createdAt])
}

model PaymentReceipt {
  id           String   @id @default(uuid()) @db.Char(36)
  paymentId    String   @db.Char(36)
  storageKey   String   @unique @db.VarChar(512)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  sizeBytes    BigInt   @db.UnsignedBigInt
  uploadedAt   DateTime @default(now()) @db.DateTime(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([paymentId, uploadedAt])
}

model DepositApplication {
  id                  String   @id @default(uuid()) @db.Char(36)
  bookingId           String   @db.Char(36)
  bookingChargeId     String   @db.Char(36)
  createdByStaffId    String   @db.Char(36)
  idempotencyKey      String?  @unique @db.VarChar(100)
  amount              Decimal  @db.Decimal(12, 2)
  reason              String   @db.VarChar(1000)
  appliedAt           DateTime @default(now()) @db.DateTime(3)

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingCharge BookingCharge @relation(fields: [bookingChargeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    StaffUser    @relation("DepositApplicationActor", fields: [createdByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bookingId, appliedAt])
  @@index([bookingChargeId])
}

model MaintenanceCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  jobs      MaintenanceJob[]
  schedules MaintenanceSchedule[]
}

model MaintenanceJob {
  id                    String           @id @default(uuid()) @db.Char(36)
  vehicleId             String           @db.Char(36)
  categoryId            String           @db.Char(36)
  maintenanceScheduleId String?          @db.Char(36)
  createdByStaffId      String           @db.Char(36)
  status                MaintenanceStatus @default(PLANNED)
  summary               String           @db.VarChar(255)
  description           String?          @db.Text
  serviceProvider       String?          @db.VarChar(160)
  scheduledStartAt      DateTime?        @db.DateTime(3)
  estimatedCompletionAt DateTime?        @db.DateTime(3)
  actualStartAt         DateTime?        @db.DateTime(3)
  completedAt           DateTime?        @db.DateTime(3)
  odometerKm            Int?             @db.UnsignedInt
  estimatedPartsCost    Decimal?         @db.Decimal(12, 2)
  estimatedLabourCost   Decimal?         @db.Decimal(12, 2)
  actualPartsCost       Decimal?          @db.Decimal(12, 2)
  actualLabourCost      Decimal?          @db.Decimal(12, 2)
  nextServiceAt         DateTime?        @db.DateTime(3)
  nextServiceOdometerKm Int?             @db.UnsignedInt
  createdAt             DateTime         @default(now()) @db.DateTime(3)
  updatedAt             DateTime         @updatedAt @db.DateTime(3)
  cancelledAt           DateTime?        @db.DateTime(3)

  vehicle           Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category          MaintenanceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schedule          MaintenanceSchedule?     @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy         StaffUser                @relation("MaintenanceCreator", fields: [createdByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  availabilityBlock VehicleAvailabilityBlock?
  expenses          Expense[]
  documents         MaintenanceDocument[]
  damageResolutions DamageResolution[]

  @@index([vehicleId, status, scheduledStartAt])
  @@index([categoryId, status])
  @@index([status, nextServiceAt])
  @@index([status, nextServiceOdometerKm])
}

model MaintenanceSchedule {
  id                   String                   @id @default(uuid()) @db.Char(36)
  vehicleId            String                   @db.Char(36)
  categoryId           String                   @db.Char(36)
  status               MaintenanceScheduleStatus @default(ACTIVE)
  dueAt                DateTime?                @db.DateTime(3)
  dueAtOdometerKm      Int?                     @db.UnsignedInt
  recurrenceDays       Int?                     @db.UnsignedInt
  recurrenceKilometres Int?                     @db.UnsignedInt
  notes                String?                  @db.VarChar(1000)
  createdAt            DateTime                 @default(now()) @db.DateTime(3)
  updatedAt            DateTime                 @updatedAt @db.DateTime(3)

  vehicle  Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  jobs     MaintenanceJob[]

  @@index([vehicleId, status, dueAt])
  @@index([status, dueAtOdometerKm])
}

model MaintenanceDocument {
  id                String   @id @default(uuid()) @db.Char(36)
  maintenanceJobId  String   @db.Char(36)
  storageKey        String   @unique @db.VarChar(512)
  originalName      String   @db.VarChar(255)
  mimeType          String   @db.VarChar(100)
  sizeBytes         BigInt   @db.UnsignedBigInt
  uploadedAt        DateTime @default(now()) @db.DateTime(3)

  maintenanceJob MaintenanceJob @relation(fields: [maintenanceJobId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([maintenanceJobId, uploadedAt])
}

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  expenses Expense[]
}

model Expense {
  id                    String               @id @default(uuid()) @db.Char(36)
  categoryId            String               @db.Char(36)
  vehicleId             String?              @db.Char(36)
  maintenanceJobId      String?              @db.Char(36)
  submittedByStaffId    String               @db.Char(36)
  approvedByStaffId     String?              @db.Char(36)
  amount                Decimal              @db.Decimal(12, 2)
  currency              String               @default("LKR") @db.Char(3)
  expenseDate           DateTime             @db.DateTime(3)
  description           String               @db.VarChar(1000)
  paymentMethod         ExpensePaymentMethod?
  vendorName            String?              @db.VarChar(160)
  vendorInvoiceReference String?             @db.VarChar(160)
  deduplicationKey      String?              @unique @db.Char(64)
  status                ExpenseStatus        @default(PENDING)
  submittedAt           DateTime             @default(now()) @db.DateTime(3)
  approvedAt            DateTime?            @db.DateTime(3)
  rejectedAt            DateTime?            @db.DateTime(3)
  approvalNote          String?              @db.VarChar(1000)

  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  maintenanceJob MaintenanceJob?  @relation(fields: [maintenanceJobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy    StaffUser       @relation("ExpenseSubmitter", fields: [submittedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy     StaffUser?      @relation("ExpenseApprover", fields: [approvedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  history        ExpenseApprovalHistory[]
  documents      ExpenseDocument[]

  @@index([expenseDate, status])
  @@index([categoryId, expenseDate, status])
  @@index([vehicleId, expenseDate, status])
  @@index([maintenanceJobId, expenseDate])
  @@index([submittedByStaffId, submittedAt])
}

model ExpenseApprovalHistory {
  id                 String       @id @default(uuid()) @db.Char(36)
  expenseId          String       @db.Char(36)
  changedByStaffId   String       @db.Char(36)
  fromStatus         ExpenseStatus?
  toStatus           ExpenseStatus
  note               String?      @db.VarChar(1000)
  occurredAt         DateTime     @default(now()) @db.DateTime(3)

  expense Expense   @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor   StaffUser @relation("ExpenseHistoryActor", fields: [changedByStaffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([expenseId, occurredAt])
  @@index([changedByStaffId, occurredAt])
}

model ExpenseDocument {
  id           String   @id @default(uuid()) @db.Char(36)
  expenseId    String   @db.Char(36)
  storageKey   String   @unique @db.VarChar(512)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  sizeBytes    BigInt   @db.UnsignedBigInt
  uploadedAt   DateTime @default(now()) @db.DateTime(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([expenseId, uploadedAt])
}

model Notification {
  id               String           @id @default(uuid()) @db.Char(36)
  recipientStaffId String           @db.Char(36)
  type             NotificationType
  title            String           @db.VarChar(200)
  body             String?          @db.VarChar(2000)
  subjectType      String?          @db.VarChar(80)
  subjectId        String?          @db.VarChar(64)
  payload          Json?
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  readAt           DateTime?        @db.DateTime(3)

  recipient StaffUser @relation("NotificationRecipient", fields: [recipientStaffId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([recipientStaffId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([subjectType, subjectId])
}

model AuditLog {
  id                   String   @id @default(uuid()) @db.Char(36)
  actorStaffUserId     String?  @db.Char(36)
  actorIdentifierSnapshot String? @db.VarChar(254)
  action               String   @db.VarChar(100)
  entityType           String   @db.VarChar(80)
  entityId             String   @db.VarChar(64)
  occurredAt           DateTime @default(now()) @db.DateTime(3)
  requestId            String?  @db.VarChar(100)
  ipAddress            String?  @db.VarChar(45)
  userAgent            String?  @db.VarChar(512)
  beforeSnapshot       Json?
  afterSnapshot        Json?

  actor StaffUser? @relation("AuditActor", fields: [actorStaffUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([entityType, entityId, occurredAt])
  @@index([actorStaffUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([requestId])
}

model BusinessProfile {
  id                 String   @id @default("default") @db.VarChar(16)
  businessName       String   @db.VarChar(160)
  legalName          String?  @db.VarChar(200)
  registrationNumber String?  @db.VarChar(100)
  publicPhone        String?  @db.VarChar(32)
  publicEmail        String?  @db.VarChar(254)
  address            String?  @db.VarChar(500)
  timezone           String   @default("Asia/Colombo") @db.VarChar(64)
  reportingCurrency  String   @default("LKR") @db.Char(3)
  updatedByStaffId   String?  @db.Char(36)
  createdAt          DateTime @default(now()) @db.DateTime(3)
  updatedAt          DateTime @updatedAt @db.DateTime(3)

  updatedBy StaffUser? @relation("BusinessProfileUpdater", fields: [updatedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

model RentalPolicy {
  id                      String   @id @default(uuid()) @db.Char(36)
  version                 Int      @unique @db.UnsignedInt
  createdByStaffId        String?  @db.Char(36)
  effectiveFrom           DateTime @db.DateTime(3)
  effectiveTo             DateTime? @db.DateTime(3)
  rentalTerms             String   @db.LongText
  cancellationTerms       String   @db.LongText
  minimumRentalHours      Int      @default(1) @db.UnsignedSmallInt
  maximumAdvanceDays      Int?     @db.UnsignedSmallInt
  advancePaymentPercent   Decimal? @db.Decimal(5, 2)
  lateReturnGraceMinutes  Int      @default(0) @db.UnsignedSmallInt
  createdAt               DateTime @default(now()) @db.DateTime(3)

  createdBy StaffUser? @relation("RentalPolicyCreator", fields: [createdByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bookings  Booking[]

  @@index([effectiveFrom, effectiveTo])
}

model SystemSetting {
  key              String   @id @db.VarChar(100)
  value            Json
  description      String?  @db.VarChar(500)
  updatedByStaffId String?  @db.Char(36)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  updatedAt        DateTime @updatedAt @db.DateTime(3)

  updatedBy StaffUser? @relation("SystemSettingUpdater", fields: [updatedByStaffId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([updatedByStaffId, updatedAt])
}

model WhatsAppMessage {
  id                String                @id @default(uuid()) @db.Char(36)
  bookingId         String                @db.Char(36)
  category          String                @db.VarChar(40)
  provider          String                @db.VarChar(40)
  templateName      String                @db.VarChar(120)
  recipient         String                @db.VarChar(32)
  status            WhatsAppMessageStatus @default(QUEUED)
  providerMessageId String?               @unique @db.VarChar(191)
  errorCode         String?               @db.VarChar(80)
  errorMessage      String?               @db.VarChar(500)
  retryCount        Int                   @default(0) @db.UnsignedSmallInt
  nextAttemptAt     DateTime?             @db.DateTime(3)
  sentAt            DateTime?             @db.DateTime(3)
  deliveredAt       DateTime?             @db.DateTime(3)
  readAt            DateTime?             @db.DateTime(3)
  createdAt         DateTime              @default(now()) @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @db.DateTime(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([bookingId, category])
  @@index([status, nextAttemptAt])
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Char(36)
  scope        String   @db.VarChar(40)
  keyHash      String   @db.Char(64)
  requestHash  String   @db.Char(64)
  bookingId    String?  @db.Char(36)
  responseBody Json?
  createdAt    DateTime @default(now()) @db.DateTime(3)
  expiresAt    DateTime @db.DateTime(3)

  @@unique([scope, keyHash])
  @@index([expiresAt])
}
